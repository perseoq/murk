{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Murk",
  "version": "1.2.1795566370",
  "identifier": "io.github.perseoq.murk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Murk",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QkM4QjFDNkRCRkIwNTkKUldSWnNMOXRISXU4eDdKd3BkNjJveVJOOG16OFpDVm5yaHBONzRUek5vMEtFekNYRmx1bHJ4YmEK",
      "endpoints": ["https://github.com/perseoq/murk/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "Rodrigo Quintanar",
    "copyright": "Copyright (C) 2026 Rodrigo Quintanar",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "licenseFile": "../LICENSE.md",
    "shortDescription": "Editor de Markdown con preview en vivo",
    "longDescription": "Murk es un editor de Markdown libre con preview en vivo, tablas, matemáticas, diagramas y exportación, con paridad funcional con Typora.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mdwn"],
        "mimeType": "text/markdown",
        "description": "Documento Markdown"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/murk.desktop",
        "files": {
          "/usr/share/applications/io.github.perseoq.murk.desktop": "../packaging/io.github.perseoq.murk.desktop"
        }
      },
      "rpm": {
        "desktopTemplate": "../packaging/murk.desktop",
        "files": {
          "/usr/share/applications/io.github.perseoq.murk.desktop": "../packaging/io.github.perseoq.murk.desktop"
        }
      },
      "appimage": {
        "files": {
          "usr/share/applications/io.github.perseoq.murk.desktop": "../packaging/io.github.perseoq.murk.desktop"
        }
      }
    }
  }
}
