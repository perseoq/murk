{
  "name": "murk",
  "private": true,
  "version": "1.2.1795201324",
  "description": "Editor de Markdown con preview en vivo (GPL-3.0-or-later)",
  "author": "Rodrigo Quintanar <djperseo@outlook.es>",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
